{
  "name": "OperatorProfiles",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Coffee van business name"
    },
    "operator_name": {
      "type": "string",
      "description": "Owner/operator name"
    },
    "bio": {
      "type": "string",
      "description": "About the business and operator"
    },
    "van_description": {
      "type": "string",
      "description": "Description of the coffee van"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Services provided (e.g., Espresso, Cold Brew, Catering)"
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of events serviced"
    },
    "location": {
      "type": "string",
      "description": "Primary operating location"
    },
    "state": {
      "type": "string",
      "enum": [
        "NSW",
        "VIC",
        "QLD",
        "SA",
        "WA",
        "TAS",
        "NT",
        "ACT"
      ],
      "description": "Operating state"
    },
    "coverage_area": {
      "type": "string",
      "description": "Service coverage area description"
    },
    "profile_image": {
      "type": "string",
      "description": "Main profile/van photo URL"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery photo URLs"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "website": {
      "type": "string",
      "description": "Website URL"
    },
    "social_instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "social_facebook": {
      "type": "string",
      "description": "Facebook page"
    },
    "built_by_tmcg": {
      "type": "boolean",
      "default": false,
      "description": "Van built by The Mobile Coffee Group"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Verified operator"
    },
    "available_for_booking": {
      "type": "boolean",
      "default": true,
      "description": "Currently accepting bookings"
    }
  },
  "required": [
    "business_name",
    "operator_name",
    "bio",
    "location",
    "state",
    "contact_email"
  ]
}