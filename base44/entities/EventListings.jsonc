{
  "name": "EventListings",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description and details"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Corporate",
        "Private Function",
        "Market/Festival",
        "Sports Event",
        "Other"
      ],
      "description": "Type of event"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the event"
    },
    "location": {
      "type": "string",
      "description": "Event location"
    },
    "state": {
      "type": "string",
      "enum": [
        "NSW",
        "VIC",
        "QLD",
        "SA",
        "WA",
        "TAS",
        "NT",
        "ACT"
      ],
      "description": "Australian state"
    },
    "expected_attendees": {
      "type": "number",
      "description": "Expected number of attendees"
    },
    "organizer_name": {
      "type": "string",
      "description": "Event organizer name"
    },
    "organizer_email": {
      "type": "string",
      "description": "Contact email"
    },
    "organizer_phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "filled",
        "completed"
      ],
      "default": "pending",
      "description": "Event status"
    }
  },
  "required": [
    "title",
    "description",
    "event_date",
    "location",
    "state",
    "organizer_name",
    "organizer_email"
  ]
}